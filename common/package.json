{
  "name": "@omarabdo/ticketing-common",
  "version": "0.1.0",
  "description": "Infra-only shared library for the ticketing services: HTTP error types, Express middleware (incl. Zod request validation), OpenAPI/Swagger-UI plumbing, and the Kafka base Publisher/Consumer (Avro-serdes aware) + kafka-wrapper. Contains NO domain/event/route contracts — those live in @omarabdo/ticketing-schemas and in each service (see ADR-0004).",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/**/*"
  ],
  "license": "ISC",
  "scripts": {
    "clean": "rimraf ./build",
    "build": "npm run clean && tsc",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/build/"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@confluentinc/kafka-javascript": "^1.0.0",
    "@confluentinc/schemaregistry": "^1.10.0",
    "@omarabdo/ticketing-schemas": "file:../schemas",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
